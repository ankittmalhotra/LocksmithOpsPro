# ==========================================
# LOCKSMITH OPERATIONS - ENVIRONMENT CONFIG
# ==========================================

# 1. DATABASE (Supabase PostgreSQL)
# In Supabase: Project Settings -> Database -> Connection string
# Prisma pooled URI (usually the Vercel Postgres integration's pooled URL):
POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/non-pooling URI (used by Prisma CLI and as a runtime fallback):
POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. AUTHENTICATION (required in production)
# ADMIN_PASSWORD is used by the built-in Admin login (username: admin) and
# signs login cookies. Changing it invalidates existing sessions.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# 3. APP URL (Used in portal links inside device-SMS drafts)
# Set to your production Vercel domain (e.g. https://locksmith-ops.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Resend revenue notifications
# Revenue changes are emailed to mail2mws@gmail.com.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="LockOps Notifications <notifications@your-verified-domain.example>"

# 5. STRIPE PAYMENTS (Optional - has test simulation fallback)
# Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
