# ==========================================
# LOCKSMITH OPERATIONS - ENVIRONMENT CONFIG
# ==========================================

# 1. DATABASE (Supabase PostgreSQL)
# In Supabase: Project Settings -> Database -> Connection string
# Prisma pooled URI (usually the Vercel Postgres integration's pooled URL):
POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/non-pooling URI (used by Prisma CLI and as a runtime fallback):
POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. AUTHENTICATION (required in production)
# ADMIN_PASSWORD is used by the built-in Admin login (username: admin) and
# signs login cookies. Changing it invalidates existing sessions.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# 3. APP URL (Used in portal links inside device-SMS drafts)
# Set to your production Vercel domain (e.g. https://locksmith-ops.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. RINGCENTRAL CALL + VOICEMAIL ANALYTICS (optional)
# The RingCentral REST API app must have ReadCallLog and ReadMessages permissions.
RC_APP_CLIENT_ID="your_ringcentral_client_id"
RC_APP_CLIENT_SECRET="your_ringcentral_client_secret"
RC_REDIRECT_URI="http://localhost:3000/api/ringcentral/callback"
RC_TARGET_PHONE_NUMBER="+14162400593"
RC_TARGET_PHONE_NUMBERS="+14372954001,+16477779493,+12894061500"
# RC_USER_JWT="optional_server_to_server_jwt"

# 5. PRIVATE ACCOUNTING RECEIPT STORAGE (AWS S3)
# Receipts are uploaded server-side and never made public.
AWS_REGION="us-east-1"
ACCOUNTING_RECEIPTS_S3_BUCKET="locksmith-operations-accounting-receipts-us-east-090819962863"
# Supply an IAM principal limited to this bucket in local/Vercel environments.
AWS_ACCESS_KEY_ID="your_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_s3_secret_access_key"

# Optional AI-assisted receipt extraction. Gemini Flash runs server-side only;
# users must review the suggestions before an expense is saved.
GEMINI_API_KEY="your_gemini_api_key"
# Optional model override (defaults to gemini-2.5-flash).
GEMINI_RECEIPT_MODEL="gemini-2.5-flash"
# For Google Cloud Vertex AI/ADC instead of an API key:
# VERTEX_AI_PROJECT="your-gcp-project"
# VERTEX_AI_LOCATION="us-central1"

# 5. Resend revenue notifications
# Revenue changes are emailed to mail2mws@gmail.com.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="LockOps Notifications <notifications@your-verified-domain.example>"

# 6. STRIPE PAYMENTS
# Stripe Dashboard -> Developers -> API Keys. Use sk_test_/pk_test_ locally.
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
# The current hosted Checkout redirect does not require this client-side key,
# but keep it available for future Stripe.js flows.
STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"
# From Stripe CLI (`stripe listen`) for local development, or the Dashboard
# webhook endpoint's signing secret for production.
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
