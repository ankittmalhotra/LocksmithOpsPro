# ==========================================
# LOCKSMITH OPERATIONS - ENVIRONMENT CONFIG
# ==========================================

# 1. DATABASE (Supabase PostgreSQL)
# In Supabase: Project Settings -> Database -> Connection string
# Transaction Pooler URI (port 6543) - used by Vercel Serverless Functions:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URI (port 5432) - used for Prisma migrations:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# For quick local testing with SQLite (optional):
# DATABASE_URL="file:./dev.db"

# 2. APP URL (Used in Twilio SMS Links)
# Set to your production Vercel domain (e.g. https://locksmith-ops.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. TWILIO SMS (Optional - has local simulation fallback)
# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+16475550199"

# 4. STRIPE PAYMENTS (Optional - has test simulation fallback)
# Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
