datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DISPATCHER
  TECHNICIAN
}

enum JobStatus {
  NEW
  DISPATCHED
  EN_ROUTE
  ON_SITE
  IN_PROGRESS
  ABANDONED_TRAVEL_FEE
  INVOICED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  INTERAC
  STRIPE_CARD
  DEBIT_CARD
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum SettlementStatus {
  UNSETTLED
  SETTLED
}

model User {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  email          String?  @unique
  passwordHash   String?
  role           Role     @default(TECHNICIAN)
  active         Boolean  @default(true)
  // Percentage of the completed job total paid to the technician, e.g. 25 = 25%.
  commissionRate Float    @default(0.0)
  createdAt      DateTime @default(now())

  dispatchedJobs Job[]        @relation("DispatcherJobs")
  assignedJobs   Job[]        @relation("TechnicianJobs")
  settlements    Settlement[] @relation("TechnicianSettlements")
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  phone            String
  extension        String?
  address          String
  unit             String?
  postalCode       String?
  notes            String?
  // Dispatcher intake does not require an email. Stripe Checkout can collect
  // it later and the webhook backfills it here.
  email            String?
  stripeCustomerId String?  @unique(map: "customer_stripe_customer_id_key")
  createdAt        DateTime @default(now())

  jobs Job[]
}

model Job {
  id             String   @id @default(uuid())
  jobNumber      String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  dispatcherId   String
  dispatcher     User     @relation("DispatcherJobs", fields: [dispatcherId], references: [id])
  technicianId   String?
  technician     User?    @relation("TechnicianJobs", fields: [technicianId], references: [id])
  // Used by manual jobs when the technician is not registered in the system.
  technicianName String?

  status              JobStatus @default(NEW)
  isManual            Boolean   @default(false)
  serviceType         String // e.g., "Commercial Lock Change", "Lockout"
  problemDescription  String
  serviceAddress      String
  // Optional two-hour intake window for manually recorded completed jobs.
  jobReceivedTimeSlot String?

  // Commission rate is snapshotted at assignment; amount is calculated at completion.
  workerCommissionRate Float @default(0.0)
  workerCommission     Float @default(0.0)

  // Abandoned job flag & travel fee
  isAbandoned     Boolean @default(false)
  travelFeeAmount Float? // 20.0, 25.0

  // Locksmith-Specific Fields
  keyBitting        String? // e.g., "SC1: 3-5-2-1-4" or "KW1"
  doorDetails       String? // e.g., "Adams Rite mortise, 1-1/8 backset"
  proofPhotoUrl     String? // Proof of work photo
  preWorkSignature  String? // Pre-work estimate & authorization to drill/service
  customerSignature String? // Customer digital signature on site

  // Automotive Specs
  vehicleYear  String?
  vehicleMake  String?
  vehicleModel String?
  vehicleVin   String?
  keyType      String? // e.g. "Transponder Chip", "Proximity Smart Fob", "Laser Cut High-Security"
  fccId        String? // Fob FCC-ID / Part code

  // Scheduled / Appointment Booking
  isScheduled  Boolean   @default(false)
  scheduledFor DateTime?

  createdAt    DateTime  @default(now())
  // Optimistic concurrency token for dispatcher edits.
  updatedAt    DateTime  @updatedAt
  dispatchedAt DateTime?
  completedAt  DateTime?

  items   JobItem[]
  invoice Invoice?
}

model JobItem {
  id          String  @id @default(uuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String // e.g. "HS mortise cylinder"
  quantity    Int     @default(1)
  unitCost    Float   @default(0.0)
  unitPrice   Float   @default(0.0)
  isPart      Boolean @default(true)
}

model Invoice {
  id    String @id @default(uuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  calculationMode      String  @default("FORWARD") // "FORWARD" or "REVERSE"
  subtotal             Float // Labor + Parts
  partsTotal           Float   @default(0.0)
  laborTotal           Float   @default(0.0)
  taxRate              Float   @default(0.13) // Ontario HST
  taxAmount            Float   @default(0.0)
  cardSurchargeRate    Float   @default(0.024) // Compliant 2.4% Canadian card cost-of-acceptance
  cardSurchargeAmount  Float   @default(0.0)
  grandTotal           Float // Final amount billed
  totalAmountCollected Float   @default(0.0)
  taxCollected         Boolean @default(true)
  cogsAmount           Float   @default(0.0)

  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  // Cash Reconciliation & Settlement
  cashOwedToCompany Float            @default(0.0)
  settlementStatus  SettlementStatus @default(UNSETTLED)

  // Twilio & Stripe tracking
  smsSent                    Boolean   @default(false)
  paymentProvider            String?
  stripeSessionId            String?
  stripeSessionStatus        String?
  stripeSessionExpiresAt     DateTime?
  stripePaymentUrl           String?
  stripePaymentLinkCreatedAt DateTime?
  stripePaymentLinkExpiresAt DateTime?
  stripeInvoiceId            String?   @unique(map: "invoice_stripe_invoice_id_key")
  stripePaymentIntentId      String?
  stripeChargeId              String?
  customerEmailCollectedAt   DateTime?
  invoiceSentAt              DateTime?
  paymentFailedAt             DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// Stripe may retry an event. A durable event ID makes webhook processing
// idempotent across retries and across multiple application instances.
model StripeWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique(map: "stripe_webhook_event_event_id_key")
  eventType   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([processedAt])
}

// Cached on-demand Google Ads daily metrics. The customer ID is part of the
// key so a future multi-account setup cannot mix spend records.
model GoogleAdsDailyMetric {
  id               String   @id @default(uuid())
  customerId       String
  date             DateTime @db.Date
  spend            Float    @default(0.0)
  conversionsValue Float    @default(0.0)
  clicks           Int      @default(0)
  impressions      Int      @default(0)
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([customerId, date])
  @@index([date])
}

model Settlement {
  id            String   @id @default(uuid())
  technicianId  String
  technician    User     @relation("TechnicianSettlements", fields: [technicianId], references: [id])
  amountSettled Float
  paymentMethod String // e.g., "CASH_HANDOVER", "BANK_TRANSFER"
  notes         String?
  settledBy     String // Admin User ID
  settledAt     DateTime @default(now())
}

// One encrypted RingCentral connection is shared by the Admin and Dispatcher
// dashboards. The app stores no RingCentral credentials in browser storage.
model RingCentralConnection {
  id                 String   @id @default("default")
  encryptedTokenData String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Server-side cache of RingCentral detailed call-log records. sourceKey is a
// deterministic provider-scoped identity used for idempotent sync upserts.
model RingCentralCallLog {
  id        String  @id @default(uuid())
  sourceKey String  @unique(map: "rc_call_source_key_key")
  sourceId  String?
  accountId String?

  sessionId          String?
  telephonySessionId String?
  direction          String?
  type               String?
  action             String?
  result             String?
  reason             String?
  transport          String?
  startTime          DateTime?
  lastModifiedTime   DateTime?
  durationSeconds    Int?
  durationMs         Int?

  callerPhoneNumber                String?
  callerPhoneNumberNormalized      String?
  callerExtensionNumber            String?
  callerName                       String?
  destinationPhoneNumber           String?
  destinationPhoneNumberNormalized String?
  destinationExtensionNumber       String?
  destinationName                  String?

  trackedDestinationId String?
  trackedDestination   RingCentralPhoneNumber? @relation(fields: [trackedDestinationId], references: [id], onDelete: SetNull)

  rawPayload Json
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([startTime], map: "rc_call_start_time_idx")
  @@index([destinationPhoneNumberNormalized, startTime], map: "rc_call_destination_start_idx")
  @@index([callerPhoneNumberNormalized, startTime], map: "rc_call_caller_start_idx")
  @@index([trackedDestinationId, startTime], map: "rc_call_phone_number_start_idx")
  @@index([telephonySessionId], map: "rc_call_telephony_session_idx")
}

// Destination-number inventory. Multiple records can share a normalized
// number when RingCentral represents distinct provider resources/extensions.
model RingCentralPhoneNumber {
  id                    String  @id @default(uuid())
  sourceKey             String  @unique(map: "rc_phone_source_key_key")
  sourceId              String?
  accountId             String?
  extensionId           String?
  phoneNumber           String
  phoneNumberNormalized String
  extensionNumber       String?
  name                  String?
  type                  String?
  usageType             String?
  status                String?
  active                Boolean @default(true)

  rawPayload Json
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  callLogs   RingCentralCallLog[]
  syncStates RingCentralCallSyncState[]

  @@unique([accountId, phoneNumberNormalized], map: "rc_phone_account_normalized_key")
  @@index([active, phoneNumberNormalized], map: "rc_phone_active_normalized_idx")
  @@index([accountId, active], map: "rc_phone_account_active_idx")
}

// Per-source synchronization checkpoint. A source can represent an account,
// destination number, or another stable partition without changing the model.
model RingCentralCallSyncState {
  id        String @id @default(uuid())
  sourceKey String @unique(map: "rc_sync_source_key_key")

  phoneNumberId String?
  phoneNumber   RingCentralPhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  syncType       String    @default("CALL_LOG")
  status         String    @default("IDLE")
  cursor         String?
  windowStart    DateTime?
  windowEnd      DateTime?
  lastAttemptAt  DateTime?
  leaseUntil     DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastError      String?
  recordsFetched Int       @default(0)
  rawPayload     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phoneNumberId, syncType], map: "rc_sync_phone_type_idx")
  @@index([status, lastAttemptAt], map: "rc_sync_status_attempt_idx")
  @@index([lastSuccessAt], map: "rc_sync_last_success_idx")
}
